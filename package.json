{
  "name": "game-vault-v2",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": "12.0.2"
  },
  "workspaces": ["apps/web", "apps/api"],
  "scripts": {
    "build:web": "npm run build --workspace=@gamevault/web",
    "build:api": "npm run build --workspace=@gamevault/api",
    "build": "npm run build:web && npm run build:api",
    "dev:web": "npm run start --workspace=@gamevault/web",
    "dev:api": "npm run start:dev --workspace=@gamevault/api"
  },
  "devDependencies": {
    "@angular/cli": "22.2.5",
    "@nestjs/cli": "12.0.11",
    "@nestjs/schematics": "12.0.12",
    "typescript": "6.0.3"
  }
}
